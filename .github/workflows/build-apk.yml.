name: Build APK
on:
  workflow_dispatch:
  push:
    tags: ['v*']

jobs:
  build:
    runs-on: ubuntu-latest
    timeout-minutes: 90
    steps:
      - uses: actions/checkout@v4
        with:
          submodules: recursive

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: |
            17
            21
          cache: gradle

      - name: Install SDK 37 (usa el SDK del runner)
        shell: bash
        run: |
          {
            export ANDROID_HOME="${ANDROID_HOME:-${ANDROID_SDK_ROOT:-/usr/local/lib/android/sdk}}"
            SM=$(command -v sdkmanager || echo "$ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager")
            yes | "$SM" --licenses > /dev/null || true
            LIST=$("$SM" --list 2>/dev/null)
            PLATS=$(echo "$LIST" | grep -oE "platforms;android-37(\.[0-9]+)?" | sort -u)
            BT=$(echo "$LIST" | grep -oE "build-tools;37\.[0-9.]+" | sort -uV | tail -n1)
            echo "Plataformas: $PLATS"; echo "Build-tools: $BT"
            if [ -n "$PLATS" ]; then "$SM" $PLATS; else "$SM" "platforms;android-37.0"; fi
            if [ -n "$BT" ]; then "$SM" "$BT"; else "$SM" "build-tools;37.0.0"; fi
            cd "$ANDROID_HOME/platforms"
            if [ ! -d android-37 ] && [ -d android-37.0 ]; then ln -s android-37.0 android-37; fi
            if [ ! -d android-37.0 ] && [ -d android-37 ]; then ln -s android-37 android-37.0; fi
            ls
            echo "ANDROID_HOME=$ANDROID_HOME" >> "$GITHUB_ENV"
            echo "ANDROID_SDK_ROOT=$ANDROID_HOME" >> "$GITHUB_ENV"
          } 2>&1 | tee "$GITHUB_WORKSPACE/sdk.log"

      - uses: gradle/actions/setup-gradle@v5

      - name: Espejo de Maven Central (evita el error 429)
        shell: bash
        run: |
          D="${GRADLE_USER_HOME:-$HOME/.gradle}/init.d"
          mkdir -p "$D"
          cat > "$D/maven-mirror.gradle" <<'EOF'
          def MIRROR = java.net.URI.create("https://maven-central.storage-download.googleapis.com/maven2/")
          def fixRepo = { repo ->
            if (repo instanceof org.gradle.api.artifacts.repositories.MavenArtifactRepository) {
              def u = repo.url.toString()
              if (u.contains("repo.maven.apache.org") || u.contains("repo1.maven.org")) {
                repo.setUrl(MIRROR)
              }
            }
          }
          beforeSettings { settings ->
            settings.pluginManagement.repositories {
              maven { url MIRROR }
              gradlePluginPortal()
              google()
              mavenCentral()
            }
            settings.pluginManagement.repositories.all(fixRepo)
            settings.dependencyResolutionManagement.repositories.all(fixRepo)
          }
          allprojects { p ->
            p.repositories.all(fixRepo)
            p.buildscript.repositories.all(fixRepo)
          }
          EOF
          cat "$D/maven-mirror.gradle"

      - name: Keystore
        shell: bash
        env:
          B64: ${{ secrets.SIGNING_KEY_STORE_BASE64 }}
          S_ALIAS: ${{ secrets.SIGNING_KEY_ALIAS }}
          S_KPASS: ${{ secrets.SIGNING_KEY_PASSWORD }}
          S_SPASS: ${{ secrets.SIGNING_STORE_PASSWORD }}
        run: |
          if [ -n "$B64" ]; then
            echo "$B64" | base64 --decode > release.jks
            ALIAS="$S_ALIAS"; KPASS="$S_KPASS"; SPASS="$S_SPASS"
          else
            keytool -genkeypair -keystore release.jks -alias viper \
              -keyalg RSA -keysize 2048 -validity 10000 \
              -storepass viper123 -keypass viper123 -dname "CN=ViperPlayer"
            ALIAS=viper; KPASS=viper123; SPASS=viper123
          fi
          {
            echo "SIGNING_KEY_ALIAS=$ALIAS"
            echo "SIGNING_KEY_PASSWORD=$KPASS"
            echo "SIGNING_STORE_PASSWORD=$SPASS"
            echo "SIGNING_KEY_STORE_PATH=$GITHUB_WORKSPACE/release.jks"
          } >> "$GITHUB_ENV"

      - name: Entorno y submódulos
        shell: bash
        run: |
          {
            echo "== JDK 17 =="; "$JAVA_HOME_17_X64/bin/java" -version 2>&1
            echo "== JDK 21 =="; "$JAVA_HOME_21_X64/bin/java" -version 2>&1
            echo "== .gitmodules =="; cat .gitmodules
            echo "== submódulos =="
            S=$(git submodule status --recursive); echo "$S"
            if grep -q '^-' <<< "$S"; then
              echo "Submódulo sin inicializar, forzando..."
              git submodule update --init --recursive --force
              git submodule status --recursive
            fi
            echo "== gradle wrapper =="; cat gradle/wrapper/gradle-wrapper.properties
          } 2>&1 | tee env.log

      - name: Build (reintenta ante 429; JDK 17 → 21 → debug)
        shell: bash
        run: |
          set +e
          chmod +x gradlew
          export GRADLE_OPTS="-Dorg.gradle.jvmargs=-Xmx4g -Dfile.encoding=UTF-8"
          GF="--stacktrace --no-daemon \
            -Dorg.gradle.java.installations.auto-detect=true \
            -Dorg.gradle.java.installations.fromEnv=JAVA_HOME_17_X64,JAVA_HOME_21_X64 \
            -Dorg.gradle.internal.repository.max.retries=6 \
            -Dorg.gradle.internal.repository.initial.backoff=2000 \
            -Dorg.gradle.internal.http.connectionTimeout=90000 \
            -Dorg.gradle.internal.http.socketTimeout=90000"
          J17="$JAVA_HOME_17_X64"; J21="$JAVA_HOME_21_X64"
          NET='Too Many Requests|status code (429|5[0-9][0-9])|timed out|Connection (reset|refused)|Premature end|Could not GET'

          gr() {
            JAVA_HOME="$1" PATH="$1/bin:$PATH" ./gradlew $GF "$2" 2>&1 | tee "$3"
            return "${PIPESTATUS[0]}"
          }

          attempt=1
          while [ $attempt -le 3 ]; do
            gr "$J17" :app:assembleRelease build-release.log; R=$?
            [ $R -eq 0 ] && break
            if grep -qiE "$NET" build-release.log; then
              cp build-release.log "build-release-red$attempt.log"
              echo "::warning::Fallo de red o 429 (intento $attempt/3). Esperando antes de reintentar..."
              sleep $((attempt * 60)); attempt=$((attempt + 1))
            else
              break
            fi
          done

          LAST="$J17"
          if [ $R -ne 0 ] && ! grep -qiE "$NET" build-release.log && ! grep -qE '^e: |CMake Error|ninja: error' build-release.log; then
            echo "::warning::Release con JDK 17 falló, probando JDK 21"
            gr "$J21" :app:assembleRelease build-release-jdk21.log; R=$?
            LAST="$J21"
          fi

          if [ $R -ne 0 ]; then
            echo "::warning::Release falló, generando debug de respaldo"
            gr "$LAST" :app:assembleDebug build-debug.log
          fi

          if ! find app/build/outputs/apk -name '*.apk' 2>/dev/null | grep -q .; then
            echo "::error::No se generó ningún APK"
            echo "=== CAUSAS (Caused by) ==="
            grep -h "Caused by:" build-*.log 2>/dev/null | awk '!s[$0]++' | head -n 15
            exit 1
          fi

      - name: Firmar si quedó sin firmar
        shell: bash
        run: |
          shopt -s nullglob
          AS=$(ls -d "$ANDROID_HOME"/build-tools/*/apksigner | sort -V | tail -n1)
          for f in app/build/outputs/apk/release/*-unsigned.apk; do
            "$AS" sign --ks release.jks \
              --ks-pass "pass:$SIGNING_STORE_PASSWORD" \
              --key-pass "pass:$SIGNING_KEY_PASSWORD" \
              --ks-key-alias "$SIGNING_KEY_ALIAS" \
              --out "${f%-unsigned.apk}-signed.apk" "$f"
          done

      - uses: actions/upload-artifact@v4
        with:
          name: viperplayer-apk
          path: app/build/outputs/apk/**/*.apk
          if-no-files-found: error

      - name: Diagnóstico automático
        if: always()
        shell: bash
        run: |
          set +e
          OUT=diagnostico.md
          CENTRAL=""
          APKS=$(find app/build/outputs/apk -name '*.apk' 2>/dev/null || true)

          analyze() {
            lf="$1"; label="$2"
            WW=$(awk '/\* What went wrong:/{p=1;next} /\* Try:/{p=0} p' "$lf" | sed '/^$/d' | head -n 25)
            CB=$(grep -E 'Caused by:' "$lf" | awk '!s[$0]++' | head -n 8)
            ROOT=$(grep -E 'Caused by:' "$lf" | tail -n 1)
            KT=$(grep -E '^e: ' "$lf" | head -n 6)
            OTH=$(grep -E 'CMake Error|ninja: error|Failed to find|Could not (resolve|find|GET)|OutOfMemoryError|No space left|Execution failed for task|toolchain' "$lf" | awk '!s[$0]++' | head -n 6)
            HINT=""
            grep -qiE 'Too Many Requests|status code 429' "$lf" && HINT="$HINT- Maven Central limitó la descarga (429): el workflow usa espejo y reintenta.\n"
            grep -qiE 'Failed to find package' "$lf" && HINT="$HINT- Paquete SDK no encontrado.\n"
            grep -qiE 'Could not (resolve|GET|find .*\.(pom|jar|aar))' "$lf" && HINT="$HINT- Dependencia o repositorio inaccesible.\n"
            grep -qiE 'OutOfMemoryError|Java heap space' "$lf" && HINT="$HINT- Falta memoria.\n"
            grep -qiE 'CMake Error|ninja: error' "$lf" && HINT="$HINT- Falla la compilación nativa C++ (NDK/CMake).\n"
            grep -qE '^e: ' "$lf" && HINT="$HINT- Error de código Kotlin.\n"
            grep -qiE 'Unsupported class file|invalid source release|Unsupported Java|toolchain' "$lf" && HINT="$HINT- Incompatibilidad de versión de JDK.\n"
            grep -qiE 'media3-settings-logic|build-logic-settings' "$lf" && HINT="$HINT- Falla el build-logic del submódulo Media3.\n"
            {
              echo ""
              echo "## Error en: $label"
              echo '```'
              [ -n "$WW" ] && echo "$WW"
              [ -n "$CB" ] && { echo "--- Caused by ---"; echo "$CB"; }
              [ -n "$KT" ] && echo "$KT"
              [ -n "$OTH" ] && echo "$OTH"
              echo '```'
              [ -n "$HINT" ] && { echo "**Causa probable:**"; printf '%b' "$HINT"; }
            } >> "$OUT"
            if [ -z "$CENTRAL" ]; then
              if [ -n "$ROOT" ]; then CENTRAL="$ROOT"
              else CENTRAL=$(printf '%s\n%s\n%s' "$WW" "$KT" "$OTH" | sed '/^$/d' | head -n 2 | tr '\n' ' ')
              fi
            fi
          }

          {
            echo "# Resultado del build"
            if [ -n "$APKS" ]; then
              echo "✅ APK generado:"
              echo "$APKS" | while read -r f; do echo "- \`$f\` ($(du -h "$f" | cut -f1))"; done
            else
              echo "❌ No se generó ningún APK"
            fi
            if [ -f build-release-jdk21.log ] && ! grep -q "BUILD FAILED" build-release-jdk21.log; then
              echo "ℹ️ El release falló con JDK 17 pero funcionó con JDK 21."
            fi
          } > "$OUT"

          for lf in build-release.log build-release-jdk21.log build-debug.log; do
            [ -f "$lf" ] && grep -q "BUILD FAILED" "$lf" && analyze "$lf" "$lf"
          done
          if [ ! -f build-release.log ] && [ -f sdk.log ] && [ -z "$APKS" ]; then
            analyze sdk.log "instalación del SDK"
          fi

          if [ -z "$CENTRAL" ] && [ -z "$APKS" ]; then
            CENTRAL="Falló antes de Gradle (checkout, submódulos, SDK o keystore)."
          fi
          if [ -n "$CENTRAL" ]; then
            if [ -n "$APKS" ]; then LVL=warning; else LVL=error; fi
            echo "::$LVL title=Problema central::$CENTRAL"
          fi
          cat "$OUT" >> "$GITHUB_STEP_SUMMARY"
          exit 0

      - uses: actions/upload-artifact@v4
        if: always()
        with:
          name: logs-y-diagnostico
          path: |
            diagnostico.md
            *.log
          if-no-files-found: ignore
